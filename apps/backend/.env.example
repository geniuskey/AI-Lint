# 확장·데스크톱 앱이 보내는 x-ai-lint-token 값. 16자 이상.
SERVICE_TOKEN=change-me-to-a-long-random-string

# gemini | openai
LLM_PROVIDER=gemini

# --- LLM_PROVIDER=gemini ---
# Google AI Studio 또는 Vertex 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LLM_PROVIDER=openai (OpenAI 호환 사내 라우터) ---
# /chat/completions 앞부분까지.
# LLM_BASE_URL=https://llm.mycorp.com/v1
# LLM_MODEL=internal-gpt-4o
# LLM_API_KEY=

# 토큰을 실을 헤더. 기본은 Authorization이고, 그때만 Bearer가 붙는다.
# LLM_AUTH_HEADER=x-llm-token
# LLM_AUTH_SCHEME=Token

# 라우터가 요구하는 필수 헤더. 문자열 값만 가진 JSON 객체.
# LLM_HEADERS={"x-dept-code":"AI-PLATFORM","x-request-source":"ai-lint"}

# 라우터가 response_format.json_schema를 거부하면 json_object로 내린다.
# LLM_RESPONSE_FORMAT=json_schema
# LLM_TIMEOUT_MS=60000

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# 이 길이를 넘는 문서는 LLM 검사를 건너뛴다 (룰 검사는 그대로 수행).
LLM_MAX_DOC_CHARS=200000

# 사용자 1인당 하루 LLM 호출 상한.
LLM_DAILY_LIMIT_PER_USER=200

# 이 개수를 넘는 블록은 잘라내고 truncated로 표시한다.
MAX_BLOCKS=2000

# 미설정 시 리포트를 저장하지 않고 메모리로만 동작한다.
# DATABASE_URL=postgres://ailint:ailint@localhost:5432/ailint
