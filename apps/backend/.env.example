# 확장·데스크톱 앱이 보내는 x-ai-lint-token 값. 16자 이상.
SERVICE_TOKEN=change-me-to-a-long-random-string

# Google AI Studio 또는 Vertex 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# 이 길이를 넘는 문서는 LLM 검사를 건너뛴다 (룰 검사는 그대로 수행).
LLM_MAX_DOC_CHARS=200000

# 사용자 1인당 하루 LLM 호출 상한.
LLM_DAILY_LIMIT_PER_USER=200

# 이 개수를 넘는 블록은 잘라내고 truncated로 표시한다.
MAX_BLOCKS=2000

# 미설정 시 리포트를 저장하지 않고 메모리로만 동작한다.
# DATABASE_URL=postgres://ailint:ailint@localhost:5432/ailint
