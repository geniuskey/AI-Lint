    "@ai-lint/labels": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.0"
  }
}
