{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "데스크톱 창의 기본 권한",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "https://*/v1/*" }
      ]
    }
  ]
}
